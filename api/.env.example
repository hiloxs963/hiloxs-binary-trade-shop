NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://hiloxs:hiloxs_test@localhost:5432/hiloxs
# BETTER_AUTH_URL=http://127.0.0.1:3000
# BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
FRONTEND_URL=http://localhost:8080
# Production only; configure the real secret in the deployment environment.
# RESEND_API_KEY=re_replace-with-a-sending-only-key
# AUTH_EMAIL_FROM=HILOXS <auth@mail.hiloxs.co.ke>

# M-Pesa Daraja is disabled in development unless every value below is configured.
# Use placeholders only here; real credentials belong in the deployment environment.
# Public production payments remain disabled unless this is explicitly set to true.
MPESA_PUBLIC_ENABLED=false
STAFF_REVIEW_ENABLED=false
MEDIA_UPLOAD_ENABLED=false
CATALOG_ACTIVATION_ENABLED=false

# Phase 8 product media uses a private AWS S3 bucket and presigned POST uploads.
# Configure all required values together before enabling either Phase 8 write flag.
# The bucket CORS policy should allow POST only from https://hiloxs.co.ke; direct reads stay disabled.
# MEDIA_S3_ENDPOINT=https://s3.af-south-1.amazonaws.com
# MEDIA_S3_REGION=af-south-1
# MEDIA_S3_BUCKET=replace-with-private-media-bucket
# MEDIA_S3_ACCESS_KEY_ID=replace-with-limited-media-access-key
# MEDIA_S3_SECRET_ACCESS_KEY=replace-with-limited-media-secret-key
# MEDIA_S3_SESSION_TOKEN=replace-with-temporary-session-token-if-used
MEDIA_S3_FORCE_PATH_STYLE=false
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
# MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
# MPESA_SHORTCODE=replace-with-business-shortcode
# MPESA_PASSKEY=replace-with-lipa-na-mpesa-passkey
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_PARTY_B=replace-with-receiving-identifier
# MPESA_CALLBACK_BASE_URL=https://api.example.test
# MPESA_MAX_AMOUNT_KES=100000
# MPESA_REQUEST_TIMEOUT_MS=10000
